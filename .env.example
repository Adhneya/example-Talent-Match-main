# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables. Never commit real values.

# Signs and encrypts the session cookie. Generate with: npx auth secret
AUTH_SECRET=

# From your LinkedIn app (developer.linkedin.com → My apps → Auth), with the product
# "Sign In with LinkedIn using OpenID Connect" added. Redirect URL to register:
#   http://localhost:3000/api/auth/callback/linkedin  (+ your Vercel URLs, same path)
AUTH_LINKEDIN_ID=
AUTH_LINKEDIN_SECRET=

# Release flags (optional)
# NEXT_PUBLIC_FLAG_MATCHES=1
# NEXT_PUBLIC_FLAG_NOTIFICATIONS=1
